rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque Dormeur n'écrit que sa propre fiche. Tout le monde (connecté) peut les lire.
    match /dormeurs/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v','nom','asp','flaw','fst','rk','asc','rt','vn','tit','best','desc','pow','look','eq','ech','mnt','sex','t','ev'])
        && request.resource.data.nom is string
        && request.resource.data.nom.size() >= 2 && request.resource.data.nom.size() <= 18
        && request.resource.data.t is number
        && request.resource.data.ev.size() <= 14
        && request.resource.data.tit.size() <= 6;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
